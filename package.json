{
  "name": "english-corrector",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time English grammar-correcting virtual microphone for macOS.",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "tsx --test src/renderer/audio/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "check:offline": "npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "esbuild": "0.25.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
